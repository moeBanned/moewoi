        { id: 'controls', k: ['phim tat', 'dieu khien', 'choi tren dien thoai', 'ban phim', 'cach dieu khien', 'phim nao'], m: 'cool', r: ['Điều khiển nhanh:\n• Mèo nhảy: chạm khung hoặc Space / ↑\n• Hứng cá: kéo ngón tay / rê chuột / ← →\n• 2048: vuốt hoặc phím mũi tên\n• Ghép ảnh: chạm ô hoặc phím mũi tên\n• Mọi game: Esc để đóng\nTrên điện thoại thì cứ chạm và vuốt là được 📱'] },
        { id: 'web_overview', k: ['web co gi', 'trang web nay', 'web nay la gi', 'gioi thieu web', 'web cua ai', 'website nay', 'trang nay co gi', 'co gi o day', 'day la web gi', 'day la dau', 'web nay co gi'], m: 'starry', r: ['Đây là nhà của Mều 🐾 Có ảnh mèo, một trang giới thiệu Joomla, và trang Mini game với 7 trò chơi. Nền web đen, đổi màu từ từ, con trỏ chuột là chân mèo, và còn có mình để tán gẫu. Bạn muốn xem phần nào?'] },
        { id: 'web_menu', k: ['menu', 'thanh menu', 'chuyen trang', 'vao dau', 'tim trang', 'trang nao', 'di dau', 'xem trang', 'trang chu', 'trang mini game'], m: 'happy', r: ['Bấm nút ☰ Menu ở thanh trên cùng: máy tính chỉ cần rê chuột vào là menu xổ xuống, điện thoại thì chạm vào. Chọn trang bạn muốn nhé. Trang Mini game có các quả bi game trôi lòng vòng đó 🎮'] },
        { id: 'web_bg', k: ['mau nen', 'doi mau', 'nen den', 'hieu ung nen', 'nen web', 'mau sac', 'nen doi mau', 'cuc quang', 'tai sao nen', 'nen tai sao'], m: 'cool', r: ['Nền web là màu đen với tối đa 3 màu trôi và đổi sắc từ từ, nhìn như cực quang vậy 🌌 Màu của menu, nút và khung chat cũng đổi theo. Nếu máy bật chế độ giảm chuyển động thì nền sẽ đứng yên.'] },
        { id: 'web_cursor', k: ['con tro', 'vet chan', 'dau chan', 'chan meo', 'giu chuot', 'keo chuot', 'con tro chuot', 'dau vet'], m: 'wink', r: ['Con trỏ chuột là bàn chân mèo: trắng khi bình thường, hồng khi rê lên nút, cam khi bấm giữ 🐾 Giữ chuột và kéo thì để lại vệt dấu chân nhỏ phát sáng. Phía sau nền còn có các đường dấu chân mèo đi vòng vòng rồi mờ dần. Trên điện thoại không có con trỏ nên phần này chỉ thấy trên máy tính.'] },
        { id: 'web_chat', k: ['ban lam duoc gi', 'ban biet gi', 'giup gi', 'tro giup', 'huong dan', 'help', 'lenh', 'chuc nang', 'ban giup duoc gi', 'ban co the lam gi', 'ban lam gi', 'giup'], m: 'happy', r: ['Mình làm được nhiều thứ nè:\n• Giải đáp về web này và 7 game\n• Tán gẫu, kể chuyện cười, đố vui, sự thật về mèo\n• Tính toán (12*5+3), xem giờ, tung xu, xúc xắc, chọn giúp ("chọn phở hay bún")\n• Nhớ tên bạn ("tên mình là ...")\nMình không phải AI thật nên câu quá lạ có thể làm mình ngơ ngác 🐱'] },
        { id: 'web_joomla', k: ['joomla', 'cms', 'trang quan tri', 'quan tri', 'lam bang gi', 'cong nghe gi', 'code gi', 'viet bang gi', 'ngon ngu gi', 'module', 'template'], m: 'cool', r: ['Joomla là hệ quản trị nội dung (CMS) mã nguồn mở, miễn phí: chỉ cần nhập bài, tải ảnh, chọn menu là có web. Web này dựng bằng Joomla: mỗi trang là một bài viết, còn hiệu ứng, game và mình là các module viết bằng HTML, CSS, JavaScript. Muốn đọc kỹ hơn thì xem trang Giới thiệu Joomla nhé.'] },
        { id: 'web_lag', k: ['lag', 'giat', 'web cham', 'nang may', 'hao pin', 'tat hieu ung', 'giam chuyen dong', 'may yeu', 'do pin', 'nong may', 'web nang', 'tat chuyen dong'], m: 'surprised', r: ['Nếu thấy giật hoặc nóng máy, bạn thử:\n• Bấm nút ⏸ Dừng chuyển động ở trang Mini game\n• Bật chế độ giảm chuyển động của điện thoại hoặc hệ điều hành (nền sẽ đứng yên)\n• Đóng bớt tab khác\n• Tải lại trang (Ctrl+F5 trên máy tính)\nNếu vẫn giật, nhắn chủ web biết máy bạn là loại nào nhé.'] },
        { id: 'web_bug', k: ['loi', 'khong chay', 'khong hien', 'bi hong', 'khong bam duoc', 'bug', 'game khong chay', 'khong vao duoc', 'bi loi', 'sao khong', 'khong duoc', 'tai khong duoc', 'trang trang', 'bi treo', 'treo may'], m: 'surprised', r: ['Ối, gặp lỗi à? Bạn thử:\n• Tải lại trang (Ctrl+F5 trên máy tính, kéo xuống để làm mới trên điện thoại)\n• Thử trình duyệt khác\n• Tắt tiện ích chặn quảng cáo nếu có\nNếu vẫn lỗi, nhắn cho chủ web biết bạn đang dùng điện thoại hay máy tính, trình duyệt nào, và chỗ nào bị hỏng nhé 🔧'] },
        { id: 'web_photos', k: ['anh meo', 'album', 'hinh meo', 'anh dep', 'hinh anh', 'xem anh', 'anh o dau', 'tai anh', 'my cat not your cat'], m: 'love', r: ['Ảnh mèo nằm ở trang chủ, kéo xuống để xem nhé 🐱 Bạn cũng có thể chơi game Ghép ảnh với chính các ảnh mèo đó.'] },
        { id: 'web_contact', k: ['lien he', 'email', 'facebook', 'gop y', 'phan hoi', 'bao loi', 'zalo', 'so dien thoai', 'nhan cho chu web'], m: 'shy', r: ['Chủ web chưa để thông tin liên hệ trong người mình đó 🙈 Nếu bạn quen chủ web thì nhắn trực tiếp nhé!'] },
        { id: 'web_privacy', k: ['du lieu', 'bao mat', 'luu tin nhan', 'cookie', 'theo doi', 'rieng tu', 'co ghi lai', 'ghi am', 'thu thap', 'gui di dau'], m: 'cool', r: ['Tin nhắn của bạn với mình chỉ nằm trên trang này và mất khi bạn tải lại, không gửi đi đâu cả. Kỷ lục game lưu ngay trong trình duyệt của bạn. Mình cũng chỉ nhớ tên bạn trong lúc đang chat thôi 🔒'] },
        { id: 'yes', k: ['ok', 'oke', 'uh', 'uhm', 'vang', 'da', 'duoc', 'dong y', 'chuan', 'chuan roi', 'dung roi', 'co'], short: 2, m: 'happy', r: ['Ok luôn! Bạn muốn làm gì tiếp nào? 🐾', 'Được nha! Còn gì mình giúp được nữa không?'] },
        { id: 'no', k: ['khong', 'thoi', 'khong phai', 'khong can', 'thoi khong'], short: 2, m: 'shy', r: ['Ừm, không sao đâu 😽 Có gì cần thì cứ gọi mình nha.', 'Ok, mình hiểu rồi. Bạn muốn làm gì khác không?'] },
        { id: 'again', k: ['nua', 'tiep', 'tiep di', 'them nua', 'nua di', 'con khong', 'con gi nua', 'lai di', 'ke nua', 'cho minh them', 'tung nua', 'do nua'], short: 3, m: 'happy', r: [function () {
            return 'Bạn muốn mình làm gì nữa nào? Gõ "giúp" để xem danh sách nhé 🐱';
        }] }
    ];

    CAU_HOI_THEM.forEach(function (x) {
        INTENTS.push({ id: 'more_' + INTENTS.length, k: x.k, m: x.m || 'happy', r: x.r });
    });

    var FALLBACK = ['Meo? Câu này khó quá, mình chưa hiểu 🙀 Bạn thử hỏi về web, game hoặc nhờ mình kể chuyện cười nhé!', 'Mình chỉ là bé mèo trả lời theo kịch bản nên chưa hiểu ý bạn. Bạn hỏi cách khác được không? 🐱', 'Hừm… mình nghiêng đầu mà vẫn chưa hiểu 😿 Gõ "giúp" để xem mình làm được gì nhé.'];

    function bestIntent(t) {
        var words = t.split(' ').length;
        var best = null;
        var bs = 0;
        for (var i = 0; i < INTENTS.length; i++) {
            var it = INTENTS[i];
            if (it.short && words > it.short) {
                continue;
            }
            var sc = 0;
            for (var j = 0; j < it.k.length; j++) {
                if (has(t, it.k[j])) {
                    sc += it.k[j].split(' ').length * 2 + 1;
                }
            }
            if (sc > bs) {
                bs = sc;
                best = it;
            }
        }
        return best ? { it: best, score: bs } : null;
    }

    function respond(it) {
        var r = it.r;
        var idx;
        do {
            idx = Math.floor(Math.random() * r.length);
        } while (r.length > 1 && idx === ctx.lastIdx[it.id]);
        ctx.lastIdx[it.id] = idx;
        var v = r[idx];
        if (typeof v === 'function') {
            v = v();
        }
        return mk(v, it.m);
    }

    function handlePending(t) {
        var p = ctx.pending;
        if (/(?:dap an|bo cuoc|khong biet|chiu|nghi hoai|bo qua)/.test(t)) {
            ctx.pending = null;
            return mk('Đáp án là: ' + p.rev + ' 😼 Muốn câu khác thì gõ "đố vui" nhé!', 'smug');
        }
        for (var i = 0; i < p.a.length; i++) {
            if (has(t, p.a[i])) {
                ctx.pending = null;
                return mk(pick(['Chính xác! Bạn giỏi quá 🎉', 'Đúng rồi đó {name}! Mèo phục sát đất 🙇']), 'starry');
            }
        }
        var b = bestIntent(t);
        if (b && b.score >= 7 && b.it.id !== 'riddle') {
            ctx.pending = null;
            return null;
        }
        p.tries += 1;
        if (p.tries >= 3) {
            ctx.pending = null;
            return mk('Hết lượt rồi! Đáp án là: ' + p.rev + ' 😹', 'smug');
        }
        return mk('Chưa đúng rồi, thử lại nhé (còn ' + (3 - p.tries) + ' lần). Gõ "đáp án" nếu muốn biết luôn.', 'wink');
    }

    function chooseFrom(s) {
        var parts = s.replace(/[?!.]+$/, '').split(/\s+(?:hay|hoặc|hoac)\s+/i);
        if (parts.length < 2) {
            return null;
        }
        parts = parts.map(function (x) {
            var y = x.trim();
            var prev;
            do {
                prev = y;
                y = y.replace(/^(?:giúp|giùm|giup|gium|cho|mình|minh|tôi|toi|em|tớ|tui|đi|di)\s+/i, '');
            } while (y !== prev);
            return y.trim();
        }).filter(function (x) {
            return x;
        });
        return parts.length >= 2 ? pick(parts) : null;
    }

    function answer(raw) {
        var t = norm(raw);
        if (!t) {
            return mk('Meo? Mình chỉ đọc được chữ thôi 😸', 'surprised');
        }
        var i;
        for (i = 0; i < CRISIS.length; i++) {
            if (has(t, CRISIS[i])) {
                ctx.pending = null;
                return mk(CRISIS_REPLY, 'sad');
            }
        }
        if (ctx.pending) {
            var pr = handlePending(t);
            if (pr) {
                return pr;
            }
        }
        var nm = raw.match(/(?:tên\s+(?:mình|tôi|em|tớ|tui)\s+là|(?:mình|tôi|em|tớ|tui)\s+tên(?:\s+là)?|gọi\s+(?:mình|tôi|em|tớ|tui)\s+là)\s+([^\s,.!?]+(?:\s+[^\s,.!?]+){0,2})/i);
        if (nm) {
            ctx.name = cap(nm[1].trim());
            ctx.last = 'name_set';
            return mk('Rất vui được gặp ' + ctx.name + '! 🐾 Mình nhớ rồi nha. Bạn muốn hỏi gì không?', 'love');
        }
        var mv = tryMath(raw);
        if (mv) {
            ctx.last = 'math';
            return mk(mv, 'cool');
        }
        if (/^(?:meo+w*|moe+w+|meow+|mew+|nya+n?)(?: (?:meo+w*|moe+w+|meow+|mew+|nya+n?))*$/.test(t)) {
            ctx.last = 'meow';
            return mk(pick(['Meo meo! 🐱', 'Meoooow~ 😸', 'Meo? Meo meo meo! 😻', 'Moew moew~ Mình nghe rồi đó!']), pick(['happy', 'wink', 'tongue']));
        }
        var rn = t.match(/(?:ngau nhien).*?(\d+) den (\d+)/) || (has(t, 'ngau nhien') ? t.match(/(\d+) den (\d+)/) : null);
        if (rn) {
            var lo = Math.min(+rn[1], +rn[2]);
            var hi = Math.max(+rn[1], +rn[2]);
            ctx.last = 'rand';
            return mk('Số ngẫu nhiên từ ' + lo + ' đến ' + hi + ' là: ' + rnd(lo, hi) + ' 🎲', 'cool');
        }
        var cm = raw.toLowerCase().match(/(?:chọn|nên)\s+(.+)/);
        var chosen = cm ? chooseFrom(cm[1]) : null;
        if (!chosen) {
            var cn = t.match(/(?:chon|nen) (.+)/);
            if (cn && /(?:^| )(?:hay|hoac) /.test(cn[1] + ' ')) {
                chosen = chooseFrom(cn[1]);
            }
        }
        if (chosen) {
            ctx.last = 'choose';
            return mk('Mình chọn: ' + chosen + ' 😼', 'smug');
        }
        var b = bestIntent(t);
        if (b) {
            ctx.unknown = 0;
            if (b.it.id === 'again') {
                var prev = null;
                for (i = 0; i < INTENTS.length; i++) {
                    if (INTENTS[i].id === ctx.last && INTENTS[i].again) {
                        prev = INTENTS[i];
                    }
                }
                if (prev) {
                    return respond(prev);
                }
            }
            ctx.last = b.it.id;
            return respond(b.it);
        }
        ctx.unknown += 1;
        if (ctx.unknown >= 2) {
            return mk('Mình ngơ ngác hơi nhiều rồi 🙀 Gõ "giúp" để xem mình làm được gì, hoặc hỏi mình về web và game nhé!', 'surprised');
        }
        return mk(pick(FALLBACK), 'surprised');
    }

    function scrollEnd() {
        msgs.scrollTop = msgs.scrollHeight;
    }

    function addMsg(text, who) {
        var d = document.createElement('div');
        d.className = 'mc-m mc-' + who;
        d.textContent = text;
        msgs.appendChild(d);
        while (msgs.children.length > 60) {
            msgs.removeChild(msgs.firstChild);
        }
        scrollEnd();
        return d;
    }

    var chain = Promise.resolve();

    function reply(res) {
        queued += 1;
        chain = chain.then(function () {
            return new Promise(function (done) {
                var el = addMsg('', 'bot');
                el.classList.add('mc-typing');
                el.innerHTML = '<i></i><i></i><i></i>';
                scrollEnd();
                setTimeout(function () {
                    el.classList.remove('mc-typing');
                    el.textContent = res.t;
                    scrollEnd();
                    mood(res.m);
                    queued -= 1;
                    done();
                }, Math.min(1500, 450 + res.t.length * 7) + rnd(0, 250));
            });
        });
    }

    function send(raw) {
        var v = raw.trim();
        if (!v || queued > 5) {
            return;
        }
        addMsg(v, 'me');
        input.value = '';
        reply(answer(v));
    }

    var started = false;

    function openChat() {
        win.hidden = false;
        root.classList.add('mc-open');
        tip.classList.remove('mc-show');
        if (!started) {
            started = true;
            reply(mk('Meo~ Mình là Mều, bé mèo trực trang web này 🐱 Bạn thử gõ "web có gì", "chơi game gì hay", "kể chuyện cười", hoặc "giúp" để xem mình làm được gì nhé!', 'happy'));
        }
        input.focus();
    }

    function closeChat() {
        win.hidden = true;
        root.classList.remove('mc-open');
    }

    fab.addEventListener('click', function () {
        if (win.hidden) {
            openChat();
        } else {
            closeChat();
        }
    });
    closeBtn.addEventListener('click', closeChat);
    document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape' && !win.hidden) {
            closeChat();
        }
    });
    input.addEventListener('input', function () {
        lastType = performance.now();
    });
    form.addEventListener('submit', function (e) {
        e.preventDefault();
        lastType = performance.now();
        send(input.value);
    });

    setTimeout(function () {
        if (win.hidden) {
            tip.classList.add('mc-show');
            clearTimeout(tipT);
            tipT = setTimeout(function () {
                tip.classList.remove('mc-show');
            }, 4500);
        }
    }, 1800);
})();
